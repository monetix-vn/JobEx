{
  "name": "job-experiment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "node scripts/format-changed.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:boundaries": "tsx tools/boundary-check/src/cli.ts",
    "test": "vitest run",
    "author": "node scripts/author.mjs",
    "content:list": "node scripts/content-list.mjs",
    "validate:packs": "tsx tools/pack-validator/src/cli.ts content --strict",
    "sim:determinism": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --weeks 52",
    "sim:smoke": "tsx tools/sim-runner/src/cli.ts run --seed 7 --weeks 52",
    "build:web": "pnpm --filter @je/demo-host build",
    "dev:web": "pnpm --filter @je/demo-host dev",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test && pnpm validate:packs && pnpm sim:determinism && pnpm sim:smoke && pnpm sim:sales && pnpm sim:qc && pnpm sim:fin && pnpm sim:prod && pnpm sim:purch && pnpm sim:inv && pnpm sim:it && pnpm sim:mkt && pnpm sim:fpa && pnpm sim:sup && pnpm sim:hr && pnpm build:web",
    "sim:sales": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario sales-year --content content",
    "build:play": "pnpm --filter @je/demo-host build:single",
    "format:all": "prettier --write .",
    "check:fast": "node scripts/check-fast.mjs",
    "ci:quiet": "node scripts/ci-quiet.mjs",
    "pin:update": "node scripts/pin-update.mjs",
    "new:scene": "node scripts/new-scene.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "sim:qc": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario qc-year --content content",
    "review:export": "node scripts/review-export.mjs",
    "balance:report": "node scripts/balance-report.mjs",
    "sim:fin": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario fin-year --content content",
    "sim:prod": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario prod-year --content content",
    "sim:purch": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario purch-year --content content",
    "sim:inv": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario inv-year --content content",
    "sim:it": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario it-year --content content",
    "sim:mkt": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario mkt-year --content content",
    "sim:fpa": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario fpa-year --content content",
    "sim:sup": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario sup-year --content content",
    "sim:hr": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario hr-year --content content"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.23.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  }
}
