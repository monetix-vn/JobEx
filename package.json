{
  "name": "job-experiment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "node scripts/format-changed.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:boundaries": "tsx tools/boundary-check/src/cli.ts",
    "test": "vitest run",
    "validate:packs": "tsx tools/pack-validator/src/cli.ts content --strict",
    "sim:determinism": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --weeks 52",
    "sim:smoke": "tsx tools/sim-runner/src/cli.ts run --seed 7 --weeks 52",
    "build:web": "pnpm --filter @je/demo-host build",
    "dev:web": "pnpm --filter @je/demo-host dev",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test && pnpm validate:packs && pnpm sim:determinism && pnpm sim:smoke && pnpm sim:sales && pnpm build:web",
    "sim:sales": "tsx tools/sim-runner/src/cli.ts check --seed 2026 --scenario sales-year --content content",
    "build:play": "pnpm --filter @je/demo-host build:single",
    "format:all": "prettier --write .",
    "check:fast": "node scripts/check-fast.mjs",
    "ci:quiet": "node scripts/ci-quiet.mjs",
    "pin:update": "node scripts/pin-update.mjs",
    "new:scene": "node scripts/new-scene.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.23.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
